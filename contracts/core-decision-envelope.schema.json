{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "X2X Personal Core Decision Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "kernel_version",
    "kernel_binding_digest",
    "capability_manifest_digest",
    "disposition",
    "reason_code",
    "authority_state",
    "verification_state",
    "forensic_receipt_id"
  ],
  "properties": {
    "schema_version": {"const": "x2x.personal.core-decision.v1"},
    "request_id": {"type": "string", "minLength": 1},
    "kernel_version": {"type": "string", "minLength": 1},
    "kernel_binding_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "capability_manifest_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "disposition": {
      "enum": [
        "ALLOW",
        "ALLOW_WITH_LIMITS",
        "MODIFY",
        "DEFER",
        "REQUIRE_HUMAN_OR_EXTERNAL_APPROVAL",
        "DENY",
        "RECOVERY_REQUIRED",
        "REVOKE"
      ]
    },
    "reason_code": {"type": "string", "minLength": 1},
    "authority_state": {"enum": ["RECOGNIZED", "NOT_RECOGNIZED", "UNKNOWN"]},
    "verification_state": {
      "enum": ["NOT_REQUIRED", "VERIFIED", "NOT_VERIFIED", "UNKNOWN", "CONFLICT"]
    },
    "bounded_grant_id": {"type": ["string", "null"]},
    "forensic_receipt_id": {"type": "string", "minLength": 1}
  }
}
